# Copy to terraform.tfvars (gitignored) and fill in real values.
subscription_id = "00000000-0000-0000-0000-000000000000"
owner           = "your-name"

location     = "swedencentral"
region_short = "sdc"
phase        = "6"

# Pick a range that overlaps none of your home networks or VPN ranges.
vnet_address_space    = ["10.0.0.0/16"]
gateway_subnet_prefix = "10.0.0.0/27"
pve_subnet_prefix     = "10.0.1.0/24"

# Phase 3: Proxmox DR node
ssh_public_key_path = "~/.ssh/azure_dr.pub"  # SSH public key authorized on the VM
pve_private_ip      = "10.0.1.10"            # static private IP inside the pve subnet
# vm_size, admin_username, disk sizes and allowed CIDRs have sensible defaults in variables.tf
