{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(terraform fmt -check:*)",
      "Bash(terraform validate:*)",
      "Bash(az account show:*)",
      "Bash(az resource list:*)",
      "Bash(az vm list:*)",
      "Bash(az vm get-instance-view:*)",
      "Bash(az network vnet-gateway list:*)",
      "Bash(az network vpn-connection show:*)",
      "Bash(az network vpn-connection list:*)",
      "Bash(az consumption usage list:*)",
      "Bash(az consumption budget list:*)",
      "Bash(ssh dr-home sudo pvecm status)",
      "Bash(ssh dr-home sudo ceph -s)",
      "Bash(ssh dr-home sudo ceph health detail)",
      "Bash(ssh dr-home sudo ha-manager status)",
      "Bash(ssh dr-home sudo rbd mirror pool status rbd-dr:*)",
      "Bash(ssh dr-azure sudo ceph -s)",
      "Bash(ssh dr-azure sudo ceph health detail)",
      "Bash(ssh dr-azure sudo systemctl is-active ceph-rbd-mirror@rbd-mirror.azure)",
      "Bash(ssh dr-azure sudo rbd mirror pool status rbd-dr:*)",
      "Bash(ssh dr-azure sudo rbd mirror image status rbd-dr/:*)",
      "Bash(date +%s)",
      "Bash(./scripts/cost-report.sh)",
      "Bash(ssh dr-home sudo pct status:*)",
      "Bash(ssh dr-home sudo pct config:*)",
      "Bash(ssh dr-azure sudo pct status:*)",
      "Bash(ssh dr-azure sudo pvesh get /cluster/sdn/vnets)"
    ],
    "ask": [
      "Bash(az vm deallocate:*)",
      "Bash(az vm start:*)",
      "Bash(terraform plan:*)",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(az group delete:*)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate*)",
      "Read(.env)",
      "Edit(scripts/**)",
      "Write(scripts/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
